# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# --- Database ---
# Local dev default (nothing to set up):
DATABASE_URL=sqlite:///./storage/ai_biz.db
# Supabase/Postgres example:
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@<project>.supabase.co:5432/postgres

# --- AI (optional) ---
# Leave blank to use the built-in rule-based fallback instead of Gemini.
GEMINI_API_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
